<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Lakbay.AgentOps</RootNamespace>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
    <UserSecretsId>Lakbay.AgentOps-4681b4fd-151f-4221-84a4-929d86723e4c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.1" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.MultiTenancy" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Autofac" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Caching.StackExchangeRedis" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Swashbuckle" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Account.Web.OpenIddict" Version="10.6.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" Version="5.4.0-preview*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lakbay.AgentOps.Application\Lakbay.AgentOps.Application.csproj" />
    <ProjectReference Include="..\Lakbay.AgentOps.EntityFrameworkCore\Lakbay.AgentOps.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\Lakbay.AgentOps.HttpApi\Lakbay.AgentOps.HttpApi.csproj" />
    <ProjectReference Include="..\Lakbay.AgentOps.Oracle\Lakbay.AgentOps.Oracle.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0027: client-side generated code for the Agent Channel's gRPC
         confirm-booking call. Copied from Lakbay.Booking.Api's Protos/ —
         see 04_TASKS.md for the open follow-up on sharing this more
         formally (a package) if a third consumer ever needs it. -->
    <Protobuf Include="Protos\bookingconfirm.proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
